# Copy to .env and fill in.

# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# BigQuery: service-account JSON key and the project that pays for query jobs.
# Leave GOOGLE_APPLICATION_CREDENTIALS empty to use `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# BQ_MAX_BYTES_BILLED=1073741824
# MAX_SQL_FAILURES_PER_TURN=3
# MAX_MODEL_CALLS_PER_TURN=10

# Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
